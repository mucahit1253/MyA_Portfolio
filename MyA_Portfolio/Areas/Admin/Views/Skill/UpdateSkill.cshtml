@model SkillViewModel

@{
    ViewData["Title"] = "Yetenek Güncelle";
}

<div class="container">
    <h2>Yeteneği Güncelle</h2>

    <form asp-action="UpdateSkill" method="post">
        <input type="hidden" asp-for="SkillId" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Yetenek Adı</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SkillGroupId" class="form-label">Kategori</label>
            <select asp-for="SkillGroupId" asp-items="ViewBag.SkillGroups" class="form-select">
                <option value="">-- Kategori Seçiniz --</option>
            </select>
            <span asp-validation-for="SkillGroupId" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">Güncelle</button>
        <a asp-action="SkillList" class="btn btn-secondary">Vazgeç</a>
    </form>
</div>
