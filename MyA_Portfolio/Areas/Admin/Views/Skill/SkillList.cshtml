@model List<Skill>

@{
    ViewData["Title"] = "Yetenekler";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-action="CreateSkill" class="btn btn-primary">Yeni Ekle</a>
        <a asp-controller="SkillGroup" asp-action="SkillGroupList" class="btn btn-outline-secondary">Kategorileri Yönet</a>
    </div>

    <table class="table table-bordered align-middle">
        <tr>
            <th>#</th>
            <th>Yetenek Adı</th>
            <th>Kategori</th>
            <th>İşlemler</th>
        </tr>
        @if (!Model.Any())
        {
            <tr><td colspan="4" class="text-center text-muted py-4">Henüz yetenek eklenmemiş</td></tr>
        }
        else
        {
            @foreach (var skill in Model)
            {
                <tr>
                    <td>@skill.SkillId</td>
                    <td>@skill.Name</td>
                    <td>
                        @if (skill.SkillGroup != null)
                        {
                            <span class="badge text-bg-light border">@skill.SkillGroup.Title</span>
                        }
                        else
                        {
                            <span class="text-muted">Kategorisiz</span>
                        }
                    </td>
                    <td>
                        <a asp-action="UpdateSkill" asp-route-id="@skill.SkillId" class="btn btn-sm btn-warning">Düzenle</a>
                        <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@skill.SkillId">
                            Sil
                        </button>
                    </td>
                </tr>

                <div class="modal fade" id="deleteModal-@skill.SkillId" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Yetenek Sil</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <p><strong>@skill.Name</strong> yeteneğini silmek istediğinize emin misiniz?</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                                <form asp-action="DeleteSkill" method="post">
                                    <input type="hidden" name="id" value="@skill.SkillId" />
                                    <button type="submit" class="btn btn-danger">Evet, Sil</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </table>
</div>
