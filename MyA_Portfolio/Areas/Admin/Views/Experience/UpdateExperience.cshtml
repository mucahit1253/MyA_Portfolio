@model ExperienceViewModel

@{
    ViewData["Title"] = "Deneyim Güncelle";
}

<div class="container">
    <h2>Deneyimi Güncelle</h2>

    <form asp-action="UpdateExperience" method="post">
        <input type="hidden" asp-for="ExperienceId" />
        <partial name="_ExperienceFormFields" model="Model" />

        <button type="submit" class="btn btn-success">Güncelle</button>
        <a asp-action="ExperienceList" class="btn btn-secondary">Vazgeç</a>
    </form>
</div>
