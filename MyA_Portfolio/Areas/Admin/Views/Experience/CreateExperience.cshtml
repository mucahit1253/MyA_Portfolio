@model ExperienceViewModel

@{
    ViewData["Title"] = "Yeni Deneyim";
}

<div class="container">
    <h2>Yeni Deneyim Ekle</h2>

    <form asp-action="CreateExperience" method="post">
        <partial name="_ExperienceFormFields" model="Model" />

        <button type="submit" class="btn btn-success">Kaydet</button>
        <a asp-action="ExperienceList" class="btn btn-secondary">Vazgeç</a>
    </form>
</div>
