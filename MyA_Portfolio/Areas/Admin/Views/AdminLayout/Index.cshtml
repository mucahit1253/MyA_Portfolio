@{
    Layout = null;

    // Breadcrumb için route bilgileri (örn: Admin / Deneyimler / DeneyimListesi)
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var pageTitle = ViewData["Title"]?.ToString() ?? action;

    // Aktif menü kontrolü
    string Active(string ctrl) =>
        string.Equals(controller, ctrl, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@pageTitle | Portfolyo Admin</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    @await Component.InvokeAsync("_AdminLayoutStyleComponentPartial")

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- ==================== SIDEBAR ==================== -->
    <aside id="sidebar-wrapper">
        <a asp-area="Admin" asp-controller="Dashbord" asp-action="Index" class="sidebar-brand">
            <div class="brand-mark">P</div>
            <div>
                <div class="fw-bold text-white lh-1" style="font-family: 'Plus Jakarta Sans';">Mehmet Mücahit.</div>
                <small class="text-white-50" style="font-size: 0.72rem;">Portfolio Admin</small>
            </div>
        </a>

        <nav class="sidebar-nav">
            <div class="nav-group-title">Genel</div>
            <a asp-area="Admin" asp-controller="Dashbord" asp-action="Index" class="sidebar-link @Active("Dashboard")">
                <i class="bi bi-speedometer2"></i><span>Dashboard</span>
            </a>

            <div class="nav-group-title">İçerik</div>
            <a asp-area="Admin" asp-controller="About" asp-action="AboutList" class="sidebar-link @Active("About")">
                <i class="bi bi-person"></i><span>Hakkımda</span>
            </a>
            <a asp-area="Admin" asp-controller="Education" asp-action="EducationList" class="sidebar-link @Active("Education")">
                <i class="bi bi-mortarboard"></i><span>Eğitim</span>
            </a>
            <a asp-area="Admin" asp-controller="Experience" asp-action="ExperienceList" class="sidebar-link @Active("Deneyimler")">
                <i class="bi bi-briefcase"></i><span>Deneyimler</span>
            </a>
            <a asp-area="Admin" asp-controller="Skill" asp-action="SkillList" class="sidebar-link @Active("Skill")">
                <i class="bi bi-code-slash"></i><span>Yetenekler</span>

            </a>
            <a asp-area="Admin" asp-controller="SkillGroup" asp-action="SkillGroupList" class="sidebar-link @Active("SkillGroup")">
                <i class="bi bi-tags"></i><span>Yetenekler Kategori</span>

            </a>

            <a asp-area="Admin" asp-controller="Category" asp-action="CategoryList" class="sidebar-link @Active("Category")">
                <i class="bi bi-tags"></i><span>Proje Kategorisi</span>
            </a>
            <a asp-area="Admin" asp-controller="Project" asp-action="ProjectList" class="sidebar-link @Active("Project")">
                <i class="bi bi-grid"></i><span>Projeler</span>
            </a>

            <div class="nav-group-title">İletişim & Sistem</div>
            <a asp-area="Admin" asp-controller="Message" asp-action="MessageList" class="sidebar-link @Active("Message")">
                <i class="bi bi-envelope"></i><span>Mesajlar</span>
            </a>
            <a asp-area="Admin" asp-controller="Message" asp-action="MessageList" class="sidebar-link @Active("Setting")">
                <i class="bi bi-gear"></i><span>Ayarlar</span>
            </a>
        </nav>

        <div class="sidebar-user">
            <div class="user-avatar">MY</div>
            <div class="overflow-hidden">
                <div class="fw-semibold text-white text-truncate" style="font-size: 0.83rem;">Mehmet Mücahir Sarıdoğan</div>
                <div style="font-size: 0.7rem; color: #B3BFDF;">Yönetici</div>
            </div>
        </div>
    </aside>

    <div class="sidebar-overlay" onclick="toggleSidebar()"></div>

    <!-- ==================== MAIN ==================== -->
    <div id="main-content-wrapper">
        @await Component.InvokeAsync("_AdminLayoutHeaderComponentPartial")

        <!-- NAVBAR -->
        

        <!-- BREADCRUMB / URL -->
        <div class="page-header">
            <h1>@pageTitle</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    @if (!string.IsNullOrEmpty(area))
                    {
                        <li class="breadcrumb-item"><a href="/@area"><i class="bi bi-house-door me-1"></i>@area</a></li>
                    }
                    @if (!string.IsNullOrEmpty(controller))
                    {
                        <li class="breadcrumb-item"><a href="@(string.IsNullOrEmpty(area) ? "" : "/" + area)/@controller">@controller</a></li>
                    }
                    @if (!string.IsNullOrEmpty(action))
                    {
                        <li class="breadcrumb-item active" aria-current="page">@action</li>
                    }
                </ol>
            </nav>
        </div>

        <!-- CONTENT -->
        <main class="main-body-container">
            @RenderBody()
        </main>

        <!-- FOOTER -->
        <footer class="admin-footer">
            <span>© @DateTime.Now.Year Poyraz. Portfolio Admin — Tüm hakları saklıdır.</span>
            <span>
                <a href="/" target="_blank">Siteyi Görüntüle</a>
                <span class="mx-2">•</span>
                <span>v1.0</span>
            </span>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            function toggleSidebar() {
                document.body.classList.toggle("sidebar-open");
            }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


