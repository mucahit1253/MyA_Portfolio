@model Message

@{
  
    ViewData["Title"] = "Mesaj Detayı";
}

<div class="card p-4" style="max-width: 700px;">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h4 class="mb-1">@Model.Subject</h4>
            <small class="text-muted">@Model.SendDate.ToString("dd.MM.yyyy HH:mm")</small>
        </div>
        @if (Model.IsRead)
        {
            <span class="badge text-bg-secondary">Okundu</span>
        }
        else
        {
            <span class="badge text-bg-danger">Yeni</span>
        }
    </div>

    <hr />

    <div class="mb-3">
        <label class="form-label text-muted">Gönderen</label>
        <p class="mb-0">@Model.NameSurname</p>
    </div>

    <div class="mb-3">
        <label class="form-label text-muted">Mesaj</label>
        <p class="mb-0" style="white-space: pre-line;">@Model.MessageDetail</p>
    </div>

    <div class="d-flex gap-2 mt-4">
        <a asp-action="MessageList" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Listeye Dön
        </a>
        <a asp-route-id="@Model.MessageId" class="btn  btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@Model.MessageId">Sil</a>
    </div>
    <div class="modal fade" id="deleteModal-@Model.MessageId" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Mesaj Sil</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p><strong>@Model.NameSurname</strong> adlı kişiden gelen mesajı silmek istediğinize emin misiniz?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                    <form asp-action="DeleteMessage" method="post">
                        <input type="hidden" name="id" value="Model.MessageId" />
                        <button type="submit" class="btn btn-danger">Evet, Sil</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    
</div>