@model MyA_Portfolio.Entities.Setting

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(Model?.SiteTitle ?? "Mehmet Mücahit Sarıdoğan | Bilgisayar Mühendisi & Full Stack Developer")</title>

    @if (!string.IsNullOrEmpty(Model?.MetaDescription))
    {
        <meta name="description" content="@Model.MetaDescription">
    }

    @if (!string.IsNullOrEmpty(Model?.FaviconUrl))
    {
        <link rel="icon" type="image/x-icon" href="@Model.FaviconUrl">
    }

    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    @await Component.InvokeAsync("_DefaultStyleComponentPartial")

</head>
