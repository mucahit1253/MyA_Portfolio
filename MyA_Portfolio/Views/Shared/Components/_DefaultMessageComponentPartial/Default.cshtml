@model Message

<div class="col-lg-7 reveal-on-scroll">
    <div class="contact-form-card">
        <form id="contactForm" asp-controller="Default" asp-action="CreateMessage" method="post" novalidate>
            <!-- Info note for ASP.NET integration -->
            <div class="alert alert-info border-0 rounded-3 small py-2 px-3 mb-4 d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-info-circle-fill fs-5"></i>
                <div>
                    <strong>Demo Modu:</strong> Bu form tasarımı ASP.NET Core MVC Controller entegrasyonu için hazırdır. Gönderim simüle edilir.
                </div>
            </div>

            <div id="formSuccessMessage" class="alert alert-success border-0 rounded-3 small py-2 px-3 mb-4 d-none" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> Mesajınız başarıyla iletildi! Teşekkür ederiz.
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label for="contactFullName" class="form-label">Adınız Soyadınız *</label>
                    <input type="text" class="form-control" id="contactFullName" asp-for="NameSurname" placeholder="Örn: Ahmet Yılmaz" required>
                    <div class="invalid-feedback">Lütfen adınızı ve soyadınızı giriniz.</div>
                </div>

                <div class="col-md-6">
                    <label for="contactEmail" class="form-label">E-posta Adresiniz *</label>
                    <input type="email" class="form-control" id="contactEmail" asp-for="Email" placeholder="Örn: ahmet@example.com" required>
                    <div class="invalid-feedback">Geçerli bir e-posta adresi giriniz.</div>
                </div>

                <div class="col-12">
                    <label for="contactSubject" class="form-label">Konu *</label>
                    <input type="text" class="form-control" id="contactSubject" asp-for="Subject" placeholder="Örn: Proje İş Birliği veya Danışmanlık" required>
                    <div class="invalid-feedback">Lütfen mesaj konusunu belirtiniz.</div>
                </div>

                <div class="col-12">
                    <label for="contactMessage" class="form-label">Mesajınız *</label>
                    <textarea class="form-control" id="contactMessage" rows="5" asp-for="MessageDetail" placeholder="Projeniz veya paylaşmak istedikleriniz hakkında detay verebilirsiniz..." required></textarea>
                    <div class="invalid-feedback">Lütfen mesajınızı yazınız.</div>
                </div>

                <div class="col-12 mt-4">
                    <button type="submit" class="btn-custom-primary w-100 justify-content-center py-3">
                        <i class="bi bi-send-fill"></i> Mesaj Gönder
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>