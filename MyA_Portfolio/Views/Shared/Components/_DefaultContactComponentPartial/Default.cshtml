
@model Contact
@{
    var linkedinSlug = Model.Linkedin.Split('/', StringSplitOptions.RemoveEmptyEntries).Last();
    var linkedinShort = linkedinSlug.Split('-')[0];
}

<!-- Left: Contact Details -->
<div class="col-lg-5 reveal-on-scroll">
    <div class="contact-info-card">
        <h4 class="fs-4 fw-bold mb-3">İletişim Bilgileri</h4>
        <p class="text-secondary mb-4">
           @Model.SubDescription
        </p>

        <div class="contact-item">
            <div class="contact-icon bg-icon-purple">
                <i class="bi bi-envelope"></i>
            </div>
            <div>
                <div class="text-secondary small fw-medium">E-posta</div>
                <a href="@Model.Email" class="text-decoration-none fw-bold text-dark">@Model.Email</a>
            </div>
        </div>

        <div class="contact-item">
            <div class="contact-icon bg-icon-blue">
                <i class="bi bi-geo-alt"></i>
            </div>
            <div>
                <div class="text-secondary small fw-medium">Konum</div>
                <div class="fw-bold text-dark">@Model.Location</div>
            </div>
        </div>

        <div class="contact-item">
            <div class="contact-icon bg-icon-mint">
                <i class="bi bi-linkedin"></i>
            </div>
            <div>
                <div class="text-secondary small fw-medium">LinkedIn</div>
                <a href="@Model.Linkedin" target="_blank" rel="noopener" class="text-decoration-none fw-bold text-dark">www.linkedin.com/in/@linkedinShort</a>
            </div>
        </div>

        <div class="contact-item">
            <div class="contact-icon bg-icon-peach">
                <i class="bi bi-github"></i>
            </div>
            <div>
                <div class="text-secondary small fw-medium">GitHub</div>
                <a href="@Model.Githup" target="_blank" rel="noopener" class="text-decoration-none fw-bold text-dark">@Model.Githup</a>
            </div>
        </div>

        <div class="mt-4 p-3 rounded-4 bg-white border border-light-subtle">
            <div class="d-flex align-items-center gap-2 text-secondary small">
                <i class="bi bi-clock-history text-primary"></i> Genellikle 24 saat içinde yanıt verilir.
            </div>
        </div>
    </div>
</div>

<!-- Right: Contact Form -->

            

   